// Build settings of the Aoshingo app target.

#include "Base.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
// AppChannel.current: one compilation condition for the channel; any other value fails to compile.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(AOSHINGO_CHANNEL_CONDITION_$(AOSHINGO_CHANNEL))
AOSHINGO_CHANNEL_CONDITION_appstore = AOSHINGO_CHANNEL_APPSTORE
AOSHINGO_CHANNEL_CONDITION_testflight = AOSHINGO_CHANNEL_TESTFLIGHT
AOSHINGO_CHANNEL_CONDITION_development = AOSHINGO_CHANNEL_DEVELOPMENT
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
CODE_SIGN_STYLE = Automatic
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Info.plist: generated, merged with Config/Info.plist for the custom AoshingoReportHost key and
// AoshingoChannel (read by Tools/release/release.sh to check an archive).
// Japanese is the development language; English comes from App/Resources/InfoPlist.xcstrings.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Aoshingo
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.navigation
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription = 交差点の信号機が発信する Bluetooth 信号（高度化PICS）を受信して、歩行者用信号の状態を表示するために使います。受信のみで、送信はしません。
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = 実測データの提供に協力している場合だけ、交差点から見たおおまかな方向（8 方位）と、「推定」の画面で交差点までの距離を求めるために使います。位置そのものは端末の外に送信しません。
INFOPLIST_KEY_NSMotionUsageDescription = 実測データの提供に協力している場合だけ、歩いているか、自転車や車に乗っているか、止まっているかを見分けるために使います。送信するのはその区分だけです。
