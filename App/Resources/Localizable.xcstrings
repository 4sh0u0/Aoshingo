        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped · last received value"
          }
        }
      }
    },
    "停止中 · 最終受信値（%lld 秒前）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped · last received value (%lld s ago)"
          }
        }
      }
    },
    "再生中のデータは実測データとして送信しません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played-back data is never sent as field data."
          }
        }
      }
    },
    "判定中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming"
          }
        }
      }
    },
