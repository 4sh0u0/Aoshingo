          }
        }
      }
    },
    "電波強度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal strength"
          }
        }
      }
    },
    "青": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green"
          }
        }
      }
    },
    "青。進めます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green. You may walk"
          }
        }
      }
    },
    "青に変わったときも知らせる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also Announce Changes to Green"
          }
        }
      }
    },
    "青点滅": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashing Green"
          }
        }
      }
    },
    "青点滅。渡り始めないでください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashing green. Do not start crossing"
          }
        }
      }
    },
    "青緑と赤。形と文字も必ず表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue-green and red, always with shapes and words."
          }
        }
      }
    },
