    },
    "更新なし。実際の信号を確認してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No updates. Check the actual signal"
          }
        }
      }
    },
    "最も近い交差点を自動で表示中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically showing the nearest intersection"
          }
