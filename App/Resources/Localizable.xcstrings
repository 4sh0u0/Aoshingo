          }
        }
      }
    },
    "表示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "表示は補助情報です。必ず実際の信号と周囲の安全を自分で確認してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the app shows is supplementary. Always check the actual signal and your surroundings yourself."
          }
        }
      }
    },
    "補助情報です。必ず実際の信号と周囲の安全を確認してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is supplementary information. Always check the actual signal and your surroundings."
          }
        }
      }
    },
    "西": {
