          "stringUnit": {
            "state": "translated",
            "value": "Developer"
          }
        }
      }
    },
    "電波の強さ（5 dB 単位）、受信の間隔、送信機の数と送信出力": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
