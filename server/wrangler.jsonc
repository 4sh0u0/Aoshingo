// SPDX-License-Identifier: Apache-2.0
// Cloudflare Worker that receives opt-in field data from the Aoshingo iOS app.
// Deployed by Workers Builds (Cloudflare's Git integration) on every push to main that touches
// server/. See README.md for the setup and docs/field-data-api.md for the API contract.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aoshingo-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  // Privacy: no Workers Logs, invocation logs or traces. The code itself never logs.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aoshingo-reports",
      // Created in APAC. The ID is not a secret. Deploys from Workers Builds apply migrations
      // first (`npm run deploy`).
      "database_id": "ca8ff962-c094-4c66-b9fd-bbf2189ef549",
      "migrations_dir": "migrations"
    }
  ],

  // Workers Rate Limiting. Periods can only be 10 or 60 seconds; counters are per Cloudflare
  // location. namespace_id must be unique within the Cloudflare account.
  "ratelimits": [
    {
      // POST /v1/reports, keyed by the upload token's random ID.
      "name": "REPORTS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      // POST /v1/challenge, /v1/attest and /v1/token, each with its own fixed global key.
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "vars": {
    // Apple Developer team ID of the app (not secret).
    "APPLE_TEAM_ID": "XTCC8DPHBX",
    "APP_BUNDLE_ID": "io.github.4sh0u0.aoshingo",
    // "true" accepts keys from the App Attest development environment (debug builds).
    "ALLOW_DEVELOPMENT_ATTESTATION": "false",
    "RETENTION_DAYS": "90",
    "TOKEN_TTL_SECONDS": "21600"
  },
  // TOKEN_SECRET (HMAC key for upload tokens, at least 32 characters) is a secret and is not
  // stored here. Set it with: npx wrangler secret put TOKEN_SECRET

  "triggers": {
    // Daily at 18:00 UTC = 03:00 JST: fold expired reports into aggregates, drop old challenges.
    "crons": ["0 18 * * *"]
  }
}
